{
    "target": "esp32s3",
    "builds": [
        {
            "name": "db-robonova2-s3",
            "sdkconfig_append": [
                "CONFIG_LANGUAGE_VI_VN=y",
                "CONFIG_HTTPD_WS_SUPPORT=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/16m_otto_robot.csv\"",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_SEND_WAKE_WORD_DATA=n",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_NONE=y",
                "CONFIG_SR_MN_EN_NONE=y",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"hai mi na;hei mi na;he lou mi na;ha luo mi na;ni hao mi na;mi na ei;mi na a;ei mi na;a mi na;mi na\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"Hi Mina\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=12"
            ]
        }
    ]
}
